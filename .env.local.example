# ==========================================================================
# RBX BANGLADESH — ENVIRONMENT VARIABLES
# Copy this file to ".env.local" and fill in your values.
# ==========================================================================

# --- Supabase (find these in Supabase → Project Settings → API) -----------
# These are safe to expose to the browser (they are "public" keys protected
# by Row Level Security). Used by @supabase/supabase-js on the client.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Admin session secret -------------------------------------------------
# Used to sign the /admin login session cookie. Generate a long random string,
# e.g. run:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# --------------------------------------------------------------------------
# NOTE FOR THIS PREVIEW:
# The application in this repository is wired to run out-of-the-box against a
# LOCAL PostgreSQL database via Drizzle ORM (no Supabase account required to
# preview). DATABASE_URL below points at that local instance.
# To deploy on Supabase instead, see SETUP.md and supabase/schema.sql.
# --------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
